# Sandbox
BL_API_KEY=
BL_WORKSPACE=

BL_API_SECRET=

# AI/LLM
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
# Base64-encoded 32-byte AES key used to encrypt user-provided OpenRouter keys.
# Generate with: openssl rand -base64 32
BYOK_ENCRYPTION_KEY=
OPENROUTER_MODEL_ID=
OPENROUTER_MODEL_ID_REVIEW=
OPENROUTER_MODEL_ID_LITE=
# Vision-capable model used by analyze_image; falls back to OPENROUTER_MODEL_ID.
OPENROUTER_VISION_MODEL_ID=
# Optional maximum image size in bytes; defaults to 20 MiB.
VISION_MAX_IMAGE_BYTES=
# Speech-to-text model used by transcribe_audio via the Gemini Interactions
# API; defaults to gemini-3.5-transcribe.
GOOGLE_TRANSCRIPTION_MODEL_ID=
# Optional maximum audio size in bytes; defaults to 25 MiB.
TRANSCRIPTION_MAX_AUDIO_BYTES=
MONID_API_KEY=

# Credits and usage. Rates are integer USD microdollars per one million tokens
# and must match the configured model IDs. 1,000 microdollars = one credit.
CREDITS_ENABLED=true
CREDITS_TRIAL_ALLOWANCE=500
CREDITS_DEFAULT_EXECUTION_CLASS=standard
CREDITS_RESERVATION_ECONOMY=25
CREDITS_RESERVATION_STANDARD=75
CREDITS_RESERVATION_DEEP=200
CREDITS_RESERVATION_TTL_SECONDS=900
CREDITS_PRICING_VERSION=v2-2026-09-13
CREDITS_BUFFER_BASIS_POINTS=12500
CREDITS_USD_MICROS_PER_CREDIT=1000
# Blaxel active sandbox list rate: $0.0414 per allocated GB-hour.
CREDITS_SANDBOX_USD_MICROS_PER_GB_HOUR=41400
CREDITS_USAGE_HISTORY_LIMIT=20
CREDITS_NOTICE_ACTIONS_REMAINING=10
CREDITS_WARNING_ACTIONS_REMAINING=5
CREDITS_URGENT_ACTIONS_REMAINING=2

# Main model launch rate (GPT-5.6 Luna: $0.20 input / $1.20 output).
CREDITS_MAIN_INPUT_USD_MICROS_PER_MILLION=200000
CREDITS_MAIN_CACHE_READ_USD_MICROS_PER_MILLION=200000
CREDITS_MAIN_CACHE_WRITE_USD_MICROS_PER_MILLION=200000
CREDITS_MAIN_OUTPUT_USD_MICROS_PER_MILLION=1200000

# Lite title model rate (Gemini 2.5 Flash Lite).
CREDITS_LITE_INPUT_USD_MICROS_PER_MILLION=100000
CREDITS_LITE_CACHE_READ_USD_MICROS_PER_MILLION=100000
CREDITS_LITE_CACHE_WRITE_USD_MICROS_PER_MILLION=100000
CREDITS_LITE_OUTPUT_USD_MICROS_PER_MILLION=400000

# Vision model rate (Gemini 2.5 Flash).
CREDITS_VISION_INPUT_USD_MICROS_PER_MILLION=300000
CREDITS_VISION_CACHE_READ_USD_MICROS_PER_MILLION=300000
CREDITS_VISION_CACHE_WRITE_USD_MICROS_PER_MILLION=300000
CREDITS_VISION_OUTPUT_USD_MICROS_PER_MILLION=2500000

# Direct credit rates for successful web tool calls. Fetch is charged once for
# each URL in the request. Set either value to zero to disable that tool charge.
CREDITS_WEB_SEARCH_CREDITS_PER_CALL=0
CREDITS_WEB_FETCH_CREDITS_PER_URL=0

# Supplier cost in integer microdollars per minute of transcribed audio.
# Google STT standard recognition is ~6000 ($0.006/min); set from the real
# invoice. Zero disables transcription charges.
CREDITS_TRANSCRIPTION_USD_MICROS_PER_MINUTE=0

# Plans and entitlements (docs/entitlements-plan.md). A tier is a monthly
# credit budget + a storage quota; features are never tier-gated.
PLAN_FREE_STORAGE_BYTES=262144000
PLAN_PLUS_MONTHLY_CREDITS=4000
PLAN_PLUS_STORAGE_BYTES=5368709120
PLAN_PRO_MONTHLY_CREDITS=12000
PLAN_PRO_STORAGE_BYTES=26843545600
# Admin storage override: a byte quota or 'unlimited'. Defaults to unlimited.
PLAN_ADMIN_STORAGE_BYTES=unlimited
# Comma-separated Neon Auth user ids granted the admin role at bootstrap.
ADMIN_USER_IDS=

# Billing. Lemon Squeezy is the global USD provider; Mayar is Indonesia (IDR).
# Replace the placeholder provider_price_id values in app.credit_products with
# real Lemon Squeezy variant IDs (ls-test:* for LEMON_SQUEEZY_MODE=test,
# ls-live:* for live). Mayar products are amount-based and do not need variant IDs.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_MODE=test
LEMON_SQUEEZY_CUSTOMER_PORTAL_URL=
MAYAR_API_KEY=
# Add this token to the Mayar webhook URL:
# https://YOUR-DOMAIN/api/billing/webhooks/mayar/YOUR_TOKEN
MAYAR_WEBHOOK_TOKEN=

# How long the agent caches per-user storage usage between scans (seconds).
STORAGE_USAGE_CACHE_TTL_SECONDS=30

# Object-native workspace storage. GCS_SA_KEY is a single-line service-account
# JSON value in hosted environments; GCS_SA_KEY_FILE is convenient locally.
GCS_PROJECT_ID=
GCS_BUCKET=beeblio-workspaces
GCS_SA_KEY=
GCS_SA_KEY_FILE=

BL_WORKSPACE=
BL_API_KEY=
BLAXEL_REGION=us-pdx-1

# Disposable Blaxel Job backend for analysis, native media processing, and
# Office/PDF skill commands. Deploy it with `pnpm deploy:analysis-job`.
BLAXEL_BATCH_ENABLED=false
BLAXEL_BATCH_JOB=beeblio-analysis
BLAXEL_BATCH_MEMORY=2048
BLAXEL_BATCH_POLL_MS=500
BLAXEL_BATCH_STARTUP_ALLOWANCE_MS=120000

# Gotenberg conversion sandbox (HTML→PDF via Chromium, Office→PDF via
# LibreOffice). Build the image with `node scripts/build-gotenberg-image.mjs`,
# then copy the emitted reference here. The sandbox scales to zero between
# conversions; ttl-idle deletes it (statelessly recreated) when idle for long.
BLAXEL_GOTENBERG_IMAGE=
BLAXEL_GOTENBERG_SANDBOX=beeblio-gotenberg
BLAXEL_GOTENBERG_MEMORY=2048
BLAXEL_GOTENBERG_IDLE_TTL=7d

# Frontend Configuration (Next.js)
# Local: http://127.0.0.1:2000 (the `pnpm dev:eve` server, reached through the
# app/eve/[...path]/route.ts proxy). Hosted: injected automatically on Vercel
# by the eve service binding (vercel.json services.web.bindings) — do NOT set
# AGENT_URL in the Vercel project environment, the binding owns it there.
# Only Eve streaming and the skills channel use this URL; workspace files go
# directly through GCS.
AGENT_URL=http://127.0.0.1:2000

# Tool activity shown in agent chat: "full" keeps expandable parameters/results;
# "compact" shows activity names only. Defaults to "full".
AGENT_TOOL_CALL_VERBOSITY=full

# Reasoning shown in agent chat: "full" keeps the expandable reasoning text;
# "compact" shows a one-line thinking status only. Defaults to "full".
AGENT_REASONING_VERBOSITY=full

# Beeblio AI rollout switch. While unset/false the chat panel is unreachable
# and nothing agent-side is provisioned — no Blaxel sandbox pre-warm, so
# visiting a project creates no sandbox. Set to "true" (e.g. on a preview
# deployment) to enable the real chat handlers.
NEXT_PUBLIC_AGENT_FEATURE_ENABLED=

# Office document previews (DOC/DOCX/ODT, XLS/XLSX, PPT/PPTX/ODP) render
# through Microsoft's Office Online viewer — view-only, no editor server.
# The app serves file bytes at /api/office/file behind a short-lived HMAC
# token. The request origin must be publicly reachable by Microsoft's servers;
# set OFFICE_VIEWER_PUBLIC_ORIGIN to a tunnel URL when testing on localhost.
OFFICE_VIEWER_PUBLIC_ORIGIN=
OFFICE_VIEWER_SECRET=

# Markdown document export. DOCX is produced by the pandoc binary (apt-get
# install pandoc; override the path with PANDOC_PATH). PDF is printed by
# Gotenberg running inside its Blaxel sandbox (see BLAXEL_GOTENBERG_IMAGE
# above; per-request budget via GOTENBERG_TIMEOUT_MS).
# PANDOC_PATH=pandoc

# Agent Tools API Keys
# Brave Search API Key (optional fallback for the brave_search tool)
BRAVE_SEARCH_API_KEY=

# Literature Search. Provider credentials stay on the server. Provider keys
# are optional but improve rate limits.
OPENALEX_API_KEY=
OPENALEX_EMAIL=
CROSSREF_MAILTO=
NCBI_API_KEY=
# Temporarily disabled providers:
# SEMANTIC_SCHOLAR_API_KEY=
# UNPAYWALL_EMAIL=
# Optional dedicated HMAC secret for short-lived save tokens. When omitted,
# EVE_AUTH_SECRET or NEON_AUTH_COOKIE_SECRET is used.
LITERATURE_RESULT_SIGNING_SECRET=
# Optional maximum open-access PDF download size; defaults to 50,000,000 bytes.
MAX_LITERATURE_PDF_BYTES=
# Literature search tuning (defaults shown).
LITERATURE_PROVIDER_TIMEOUT_MS=12000
LITERATURE_MAX_MERGED_RESULTS=30
LITERATURE_MAX_PAGE=50
LITERATURE_PER_SOURCE_RESULTS=8
LITERATURE_RESULT_TOKEN_TTL_SECONDS=43200
LITERATURE_PDF_MAX_REDIRECTS=5
LITERATURE_PDF_TIMEOUT_MS=30000

# Google AI Studio API key (required for transcribe_audio, gemini-3.5-transcribe)
GOOGLE_API_KEY=

# Database (Neon Postgres). Pooled connection string for the app DB.
# Stores projects and agent session records; identity is owned by Neon Auth.
# drizzle.config.ts reads this from .env.local for db:push/migrate/studio.
DATABASE_URL=

# Canonical public origin of the site, without a trailing slash.
# Drives metadataBase, canonical URLs, OpenGraph, sitemap, RSS, and llms.txt.
# Production: https://beeblio.org
NEXT_PUBLIC_SITE_URL=

# Neon Auth (managed Better Auth on the same Neon database).
# Enable Auth on the Neon project, then copy NEON_AUTH_BASE_URL from the Console.
# Generate the cookie secret with: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Shared HMAC secret between the Next.js /eve proxy and the eve channel auth.
# The proxy mints a short-lived JWT (asserting the Neon Auth user id) that the
# eve backend verifies with this secret. Generate with: openssl rand -base64 32
# Must match the eve backend's (AGENT_URL) EVE_AUTH_SECRET.
EVE_AUTH_SECRET=
# Optional onboarding demo overrides. Development automatically uses the
# generated .demo-project archive when present.
DEMO_PROJECT_TEMPLATE_PATH=
DEMO_PROJECT_TEMPLATE_URL=
# Demo template archive safety cap; defaults to 8 MiB.
DEMO_PROJECT_MAX_ARCHIVE_BYTES=8388608

# Operational limits (defaults shown; see docs/entitlements-plan.md §12).
WORKSPACE_LIST_MAX_ENTRIES=2000
OFFICE_PREVIEW_TIMEOUT_MS=45000
WORKSPACE_JSON_MAX_BYTES=65536
DASHBOARD_RECENT_SESSIONS=5
AGENT_TOKEN_TTL_SECONDS=60
TITLE_MAX_LENGTH=80
TITLE_TIMEOUT_MS=10000
MAX_BIB_IMPORT_BYTES=10000000
MAX_PAPER_IMPORT_BYTES=50000000
EXPORT_MAX_MARKDOWN_CHARS=4000000
EXPORT_MAX_DIAGRAMS=60
EXPORT_MAX_SVG_BYTES=4000000
EXPORT_MAX_PNG_BYTES=16000000
EXPORT_MAX_REMOTE_IMAGE_BYTES=20000000
EXPORT_REMOTE_IMAGE_TIMEOUT_MS=20000
GOTENBERG_TIMEOUT_MS=120000
PANDOC_TIMEOUT_MS=120000
PANDOC_MAX_BUFFER_BYTES=268435456
OFFICE_VIEWER_ACCESS_TOKEN_TTL_SECONDS=43200
